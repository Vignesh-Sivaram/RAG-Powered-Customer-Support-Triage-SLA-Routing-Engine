    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify the support ticket into JSON with strictly 3 keys: priority, category, sentiment.\n\nRules:\n- priority: \"High\" ONLY for outages, lockouts, failed payments, or double charges. Otherwise \"Low\".\n- category: \"Billing\" (invoice, refund, payment), \"Account Access\" (login, locked out, permissions), \"Feature Request\" (new feature, export), or \"Technical Bug\" (crash, 500 error, slow).\n- sentiment: \"Frustrated\", \"Neutral\", or \"Positive\".\n\nExamples:\nIssue: \"Our team is locked out of the admin portal!\" -> {\"priority\":\"High\",\"category\":\"Account Access\",\"sentiment\":\"Frustrated\"}\nIssue: \"Love the app! Can you add an Excel export button?\" -> {\"priority\":\"Low\",\"category\":\"Feature Request\",\"sentiment\":\"Positive\"}\nIssue: \"How can I download our past monthly GST invoice PDF?\" -> {\"priority\":\"Low\",\"category\":\"Billing\",\"sentiment\":\"Neutral\"}\n\nClassify this ticket:\nCustomer Name: {{ $json['Customer Name'] }}\nCustomer Issue: {{ $json['Issue facing/Feedback'] }}",
        "hasOutputParser": true,
        "batching": {}
      },
